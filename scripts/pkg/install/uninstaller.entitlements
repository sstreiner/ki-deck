<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements of the uninstaller app when it is signed for notarization (hardened runtime).
     The uninstall asks Stream Deck to quit with an Apple event (osascript), which a hardened app
     may only send with this entitlement; macOS still asks the user once. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
