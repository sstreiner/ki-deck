<?xml version="1.0" encoding="utf-8"?>
<!-- Installer.app layout for dist/ki-deck-<version>.pkg (scripts/pkg/build.mjs fills
     in @VERSION@). Installs for the current user only: no administrator password, and the
     scripts run as that user. hostArchitectures keeps Apple silicon Macs from asking for Rosetta. -->
<installer-gui-script minSpecVersion="2">
  <title>ki-deck</title>
  <organization>net.streiner</organization>
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <volume-check>
    <allowed-os-versions>
      <os-version min="13.0"/>
    </allowed-os-versions>
  </volume-check>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <choices-outline>
    <line choice="default">
      <line choice="net.streiner.ki-deck"/>
    </line>
  </choices-outline>
  <choice id="default"/>
  <choice id="net.streiner.ki-deck" visible="false">
    <pkg-ref id="net.streiner.ki-deck"/>
  </choice>
  <pkg-ref id="net.streiner.ki-deck" version="@VERSION@" onConclusion="none">plugin.pkg</pkg-ref>
</installer-gui-script>
